# ---- Python ----
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# ---- 构建产物（PyInstaller / build_win.bat 自动生成）----
# build/ 存放 PyInstaller 中间产物，dist/ 存放最终分发目录与发布存档（v0.8.0 整改后布局）
build/
dist/
out/
*.spec
# Tavily.spec 是 Windows 构建所需，随仓库发布，需取消忽略
!Tavily.spec

# ---- 运行数据（v0.3.0 起统一集中在 data/）----
data/
# 保留旧位置忽略规则，防止历史遗留文件被误提交
config.json
keys.txt
tavily_keys.db
tavily_keys.db-*
.tavily-secret.key
.env*
*.pem
*.key
*.p12
*.pfx
*.log

# ---- 调试残留 ----
webview_dump.json
_check_exe.py
_diag*
_*.png

# ---- 编辑器 / 系统 / 其他 ----
.DS_Store
Thumbs.db
.idea/
.vscode/
.qoder/
docs/wiki/wiki-manifest.json
docs/memory/

# ---- 前端（web/，npm 依赖与 vite 构建产物）----
web/node_modules/
web/dist/
Tavily.lnk

.coverage
.coverage.*
.htmlcov/

